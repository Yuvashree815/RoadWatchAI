# RoadWatch AI — Environment Variables Configuration Example
# Copy this file to .env and configure your local settings.

# ── 1. Web Application URLs ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ── 2. Mode & Safety Controls ─────────────────────────────────────────────────
# Set MOCK_LLM=true to run offline without calling Gemini API (conserves quota)
MOCK_LLM=false
# Set DEMO_MODE=true to mark all records as synthetic demo records
DEMO_MODE=true

# ── 3. Google Gemini LLM Configuration (Multimodal Vision) ────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ── 4. LangSmith Observability & Tracing (Optional) ───────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=RoadWatchAI
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── 5. Real Complaint Email Submission (SMTP) ─────────────────────────────────
# Set EMAIL_ENABLED=true to activate email submission in the workflow
EMAIL_ENABLED=false
# Set MOCK_EMAIL=true to simulate sending without requiring real SMTP credentials
MOCK_EMAIL=true
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=roadwatch-noreply@demo.local
# The actual destination address for presentation/demo emails:
DEMO_COMPLAINT_EMAIL=demo-inbox@yourdomain.com

# ── 6. Structured Database & Vector Store ─────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
CHROMA_PERSIST_DIRECTORY=./chroma_data