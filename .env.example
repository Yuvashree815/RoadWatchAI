# RoadWatch AI — Environment Variables Configuration Template
# For local development: copy to .env
# For Railway deployment: enter these keys in Railway Dashboard -> Variables
# For Vercel deployment: enter NEXT_PUBLIC_API_URL in Vercel Project Settings -> Environment Variables

# ── 1. Web Application URLs ───────────────────────────────────────────────────
# In Railway: Set FRONTEND_URL to your Vercel domain (e.g. https://roadwatch-ai.vercel.app)
FRONTEND_URL=http://localhost:3000
# In Railway: Set BACKEND_URL to your Railway domain (e.g. https://roadwatch-production.up.railway.app)
BACKEND_URL=http://localhost:8000
# In Vercel: Set NEXT_PUBLIC_API_URL to your Railway domain
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── 2. Production Mode & Safety Controls ──────────────────────────────────────
# Production: MOCK_LLM=false (uses Google Gemini)
MOCK_LLM=false
# Production: MOCK_EMAIL=false (uses real Gmail SMTP delivery)
MOCK_EMAIL=false
# Production: EMAIL_ENABLED=true (enables complaint delivery workflow)
EMAIL_ENABLED=true
# Production: DEMO_MODE=true (ensures synthetic safety disclaimers remain on generated data)
DEMO_MODE=true

# ── 3. Google Gemini LLM Configuration (Multimodal Vision) ────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ── 4. LangSmith Observability & Tracing ──────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=RoadWatchAI
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── 5. Real Complaint Email Submission (Gmail SMTP) ───────────────────────────
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_16_char_app_password
SMTP_FROM=your_gmail_address@gmail.com
# Destination demonstration inbox to receive verified complaint notifications & PDF attachments:
DEMO_COMPLAINT_EMAIL=your_inbox@gmail.com

# ── 6. Vector Store & Database Persistence ────────────────────────────────────
# Auto-built on Railway startup from repository documents/contracts/*.pdf
CHROMA_PERSIST_DIRECTORY=./chroma_data
# Optional Supabase integration (falls back to local data/*.csv automatically)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_service_role_key